{
  "name": "calicocutters",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/clean-dist.mjs",
    "build:python": "python scripts/build_python_zip.py",
    "build": "python scripts/build_python_zip.py && tsc --noEmit && vite build",
    "postbuild": "node scripts/write-root-redirect.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "python -m pytest -q"
  },
  "dependencies": {
    "imagetracerjs": "^1.2.6",
    "lucide-react": "^0.468.0",
    "manifold-3d": "^3.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svgpath": "^2.6.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
